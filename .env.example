# ─────────────────────────────────────────────────────────────────────────
# Environment configuration — TEMPLATE
#
# Copy to `.env` and fill in real values. `.env` is gitignored; this file is
# committed so the required configuration is documented without leaking it.
#
# In production these live in the Netlify dashboard, never in a file.
# See docs/runbooks/credential-rotation.md
# ─────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════
# PUBLIC — inlined into the browser bundle at build time
#
# The `VITE_` prefix is not decoration. It instructs Vite to substitute the
# value directly into client-side JavaScript. Anyone can read these with
# devtools on the deployed site.
#
# Rule: if you would not print it on a billboard, it must NOT have a
# `VITE_` prefix.
# ═════════════════════════════════════════════════════════════════════════

# Supabase project URL. Public.
VITE_SUPABASE_URL=

# Supabase PUBLISHABLE key (sb_publishable_…). Public *by design*: it
# identifies the caller as an anonymous visitor. It is not a password. What
# actually constrains it is Row Level Security on the database. Replaces the
# legacy VITE_SUPABASE_ANON_KEY (ADR 0003; legacy keys are disabled).
# See supabase/migrations/0001_meetings_rls.sql
VITE_SUPABASE_PUBLISHABLE_KEY=


# ═════════════════════════════════════════════════════════════════════════
# SECRET — server-side only, Netlify Functions
#
# These are never prefixed with VITE_. They exist only in the Netlify
# Functions runtime and in your local .env.
# ═════════════════════════════════════════════════════════════════════════

# Supabase project URL, for the function. Same value as VITE_SUPABASE_URL.
SUPABASE_URL=

# Supabase SECRET key (sb_secret_…). BYPASSES ALL ROW LEVEL SECURITY.
# This is the most dangerous value in the project. It grants unrestricted read
# and write on every table. Prefixing this with VITE_ would publish full
# database access to every visitor. Replaces the legacy service role key
# (ADR 0003). Create one per place it's used, so each can be revoked alone.
SUPABASE_SECRET_KEY=

# Gmail account used to send booking confirmations.
GMAIL_USER=

# Gmail app password (16 chars, no spaces when pasted into Netlify).
# Generated at https://myaccount.google.com/apppasswords
# Grants send-as rights on the whole mailbox — rotate if ever exposed.
GMAIL_APP_PASSWORD=

# Fallback meeting room sent to every client who books (ROADMAP P1.1).
# A Zoom personal room, or a Google Meet link made from meet.google.com — not
# from Google Calendar, whose links expire after 60 idle days. Must be https.
# Not a secret, but server-side on purpose: anything VITE_-prefixed would
# publish your room to anyone reading the site's JavaScript. If unset, emails
# say the link will follow and your copy flags it.
#
# Netlify's free plan applies every variable to all scopes, builds included.
# That's safe for names WITHOUT the VITE_ prefix: Vite only inlines VITE_
# variables into the bundle, so the build can see this value but never ships
# it. The prefix, not the scope, is the line between public and private.
MEETING_ROOM_URL=

# Where "new meeting booked" notifications are delivered.
# This is the operator inbox (identity #2 in ADR 0002). Private; never shown
# on the site. The public-facing contact address lives in src/config/site.js,
# not here, because it is display content rather than configuration.
OPERATOR_EMAIL=
