# Dependencies
node_modules

# Build output
dist
dist-ssr
.netlify

# ─────────────────────────────────────────────────────────────
# Secrets — see docs/decisions/0001-secrets-out-of-version-control.md
# .env.example IS committed (documents required vars, holds no values).
# Everything else in the .env family stays local.
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Local-only overrides
*.local

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# NOTE: package-lock.json was previously listed here and should not be.
# The lockfile pins exact transitive dependency versions, which is what makes
# `npm ci` reproducible between your machine and the Netlify build container.
# Ignoring it means two builds from the same commit can install different
# code. It must be committed. (It already was, so the ignore line was both
# wrong and inert — but the intent it encoded was wrong too.)
